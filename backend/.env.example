# Evaluador: "real" (agente + Gemini, por defecto) o "falso" (simulado, sin créditos)
EVALUADOR=real
# Modo de evaluación: "agente" (defecto, orquesta con herramientas) o "pipeline" (directo, menos llamadas al LLM)
MODO_EVALUACION=agente

# Clave de Vertex AI express mode (NUNCA la subas al repo)
GEMINI_API_KEY=
# Modelo de Gemini; Google los renombra seguido
GEMINI_MODEL=gemini-3.1-flash-lite
# Usar Vertex AI en lugar de la API pública de Gemini
GOOGLE_GENAI_USE_VERTEXAI=true
# Carpeta donde se guardan los PDF subidos (opcional; por defecto backend/uploads)
# UPLOADS_DIR=
